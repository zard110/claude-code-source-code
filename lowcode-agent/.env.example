# Locode Agent 环境变量配置
#
# 配置文件位置：~/.locode/.env（全局）
# 也可以在项目目录创建 .env.local 覆盖全局配置
#
# 首次运行 locode 会自动创建此文件模板

# 默认 AI 提供商（centit / qwen / deepseek / openai）
AI_PROVIDER=centit

# ── Centit ──
CENTIT_BASE_URL=https://your-centit-url/api/llvm
CENTIT_API_KEY=your-api-key
CENTIT_PLANNER_MODEL=qwq
CENTIT_MODELS=qwq

# ── 阿里云百炼（可选） ──
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=sk-your-key
# QWEN_PLANNER_MODEL=qwen3.5-plus
# QWEN_MODELS=qwen3.5-plus,qwen3,glm-5

# ── DeepSeek（可选） ──
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_MODELS=deepseek-chat

# ── OpenAI（可选） ──
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODELS=gpt-4o,gpt-4o-mini
